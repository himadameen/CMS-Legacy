    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "legalName": {
      "type": "string"
    },
    "logoTagline": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean"
    },
    "AboutBrand": {
      "type": "text"
    },
    "main_categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::main-category.main-category",
      "mappedBy": "brand"
    },
    "skuPrefix": {
      "type": "string"
    }
  }
